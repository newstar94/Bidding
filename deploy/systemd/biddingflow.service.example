[Unit]
Description=BiddingFlow web application
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=exec
User=biddingflow
Group=biddingflow
WorkingDirectory=/opt/biddingflow/current
# Process defaults live with the process manager so web.env only needs an
# override after capacity testing. EnvironmentFile values take precedence.
Environment=UVICORN_WORKERS=4
Environment=UVICORN_LIMIT_CONCURRENCY=256
Environment=UVICORN_BACKLOG=512
Environment=UVICORN_TIMEOUT_KEEP_ALIVE=5
Environment=UVICORN_MAX_REQUESTS=10000
Environment=UVICORN_MAX_REQUESTS_JITTER=1000
Environment=UVICORN_WS_MAX_SIZE=65536
Environment=UVICORN_WS_MAX_QUEUE=16
EnvironmentFile=/etc/biddingflow/web.env
EnvironmentFile=/etc/biddingflow/database-web.env
RuntimeDirectory=biddingflow-metrics
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=no
Environment=BIDDING_METRICS_MULTIPROCESS_DIR=/run/biddingflow-metrics
ExecStart=/opt/biddingflow/venv/bin/python -m uvicorn backend.app:app --host 127.0.0.1 --port 8000 --workers ${UVICORN_WORKERS} --no-proxy-headers --limit-concurrency ${UVICORN_LIMIT_CONCURRENCY} --backlog ${UVICORN_BACKLOG} --timeout-keep-alive ${UVICORN_TIMEOUT_KEEP_ALIVE} --limit-max-requests ${UVICORN_MAX_REQUESTS} --limit-max-requests-jitter ${UVICORN_MAX_REQUESTS_JITTER} --ws-max-size ${UVICORN_WS_MAX_SIZE} --ws-max-queue ${UVICORN_WS_MAX_QUEUE}
Restart=on-failure
RestartSec=3s
TimeoutStartSec=90s
TimeoutStopSec=45s
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
ReadWritePaths=/var/lib/biddingflow
UMask=0027

[Install]
WantedBy=multi-user.target
