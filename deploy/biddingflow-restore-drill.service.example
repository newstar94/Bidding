[Unit]
Description=Restore and verify the newest BiddingFlow backup
Documentation=file:/opt/biddingflow/scripts/backup.py
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/var/backups/biddingflow /var/lib/biddingflow

[Service]
Type=oneshot
User=biddingflow-backup
Group=biddingflow
WorkingDirectory=/opt/biddingflow
# This file contains the isolated drill DSN and the Ed25519 private signing
# key. It must not be readable by the web-service account.
EnvironmentFile=/etc/biddingflow/biddingflow-restore-drill.env
ExecStart=/opt/biddingflow/.venv/bin/python /opt/biddingflow/scripts/backup.py drill-latest
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
PrivateTmp=true
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=true
ProtectSystem=strict
ProtectHome=true
ProtectProc=invisible
ProcSubset=pid
ReadOnlyPaths=/var/backups/biddingflow
ReadWritePaths=/var/lib/biddingflow/observability
