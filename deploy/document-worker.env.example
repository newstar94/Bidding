# Standalone document worker only. Install outside the release as
# /etc/biddingflow/document-worker.env, root:root mode 0600. Do not copy
# web.env, aggregate database secrets, SMTP, payment or AI keys into this file.
# database-document-worker.env is generated separately by
# scripts/prepare_production_database_env.py and supplies only the scoped URL.
# The generated database fragment also carries APP_ENV=production; the host
# verifier permits that one duplicate only when the values match.
APP_ENV=production
DOCUMENT_WORKER_EXECUTION_MODE=external
DOCUMENT_WORKER_SERVICE_USER=biddingflow-document-worker
DOCUMENT_WORKER_SERVICE_GROUP=biddingflow-documents
# Replace with the actual numeric GID returned by getent group.
DOCUMENT_WORKER_SHARED_GID=REPLACE_WITH_BIDDINGFLOW_DOCUMENTS_GID
DOCUMENT_WORKER_TEMP_DIR=/var/lib/biddingflow-document-jobs
# Change both to true only after the dedicated identity, encrypted shared
# exchange mount and correct 0770 ownership have been verified on this host.
DOCUMENT_WORKER_SERVICE_ACCOUNT_CONFIRMED=false
DOCUMENT_WORKER_SHARED_STORAGE_CONFIRMED=false
DOCUMENT_WORKER_SANDBOX=bwrap
DOCUMENT_WORKER_SANDBOX_EXECUTABLE=/usr/bin/bwrap
DOCUMENT_WORKER_REQUIRE_PRIVILEGE_DROP=true
DOCUMENT_WORKER_SANDBOX_UID=65534
DOCUMENT_WORKER_SANDBOX_GID=65534
# Keep capacity settings consistent with web.env and the deployed worker count.
DOCUMENT_WORKER_MAX_CONCURRENCY=4
DOCUMENT_WORKER_INSTANCE_COUNT=1
DOCUMENT_WORKER_QUEUE_SIZE=2
