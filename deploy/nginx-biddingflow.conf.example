# BiddingFlow reverse-proxy baseline. Replace the domain and certificate paths.
# The application must listen only on the internal address 127.0.0.1:8000.

map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 443 ssl http2;
    server_name bidding.example.com;

    ssl_certificate /etc/letsencrypt/live/bidding.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/bidding.example.com/privkey.pem;

    location / {
        client_max_body_size 11m;
        client_body_timeout 15s;
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Overwrite attacker-supplied forwarding headers. Do not use
        # an append-style forwarding value here because the app validates the chain.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP "";
        proxy_set_header Forwarded "";

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 75s;
    }
}

server {
    listen 80;
    server_name bidding.example.com;
    return 301 https://$host$request_uri;
}
