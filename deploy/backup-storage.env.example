# Non-secret storage profile for backup commands. Copy outside the release to
# /etc/biddingflow/backup-storage.env, root:root mode 0600, and make these paths
# match the deployed web process. Never copy web.env or its secrets here.
BIDDING_DATA_DIR=/var/lib/biddingflow
BIDDING_BACKUP_DIR=/var/lib/biddingflow/backups
BIDDING_UPLOAD_DIR=/var/lib/biddingflow/templates/images
BIDDING_WORD_TEMPLATE_DIR=/var/lib/biddingflow/templates/words
