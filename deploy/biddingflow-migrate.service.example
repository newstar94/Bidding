[Unit]
Description=Initialize or upgrade the BiddingFlow PostgreSQL schema
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=biddingflow
Group=biddingflow
WorkingDirectory=/opt/biddingflow
EnvironmentFile=/etc/biddingflow/biddingflow-migrator.env
ExecStart=/opt/biddingflow/.venv/bin/python /opt/biddingflow/scripts/manage_database.py
UMask=0077
PrivateTmp=true
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/biddingflow
