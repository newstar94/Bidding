[Unit]
Description=BiddingFlow ASGI service (PostgreSQL)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=biddingflow
Group=biddingflow
WorkingDirectory=/opt/biddingflow
EnvironmentFile=/etc/biddingflow/biddingflow.env
ExecStartPre=/opt/biddingflow/.venv/bin/python scripts/verify_document_sandbox.py
ExecStart=/opt/biddingflow/.venv/bin/uvicorn backend.app:app --host 127.0.0.1 --port 8000 --workers ${UVICORN_WORKERS} --no-proxy-headers --limit-concurrency 256 --backlog 1024 --timeout-keep-alive 5 --timeout-graceful-shutdown 30 --ws-max-size 65536 --ws-max-queue 32
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
PrivateTmp=true
NoNewPrivileges=true
LockPersonality=true
PrivateDevices=true
ProtectClock=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictRealtime=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/biddingflow /var/log/biddingflow /var/backups/biddingflow /var/tmp/biddingflow-document-worker
UMask=0077

[Install]
WantedBy=multi-user.target
