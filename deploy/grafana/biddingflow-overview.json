{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "title": "Request rate by status",
      "type": "timeseries",
      "targets": [{"refId": "A", "expr": "sum by (status) (rate(biddingflow_http_requests_total[5m]))", "legendFormat": "{{status}}"}],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
    },
    {
      "id": 2,
      "title": "HTTP latency quantiles",
      "type": "timeseries",
      "targets": [
        {"refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(biddingflow_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p50"},
        {"refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(biddingflow_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p95"},
        {"refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(biddingflow_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p99"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
    },
    {
      "id": 3,
      "title": "Worker queue depth",
      "type": "timeseries",
      "targets": [{"refId": "A", "expr": "biddingflow_worker_pool_queued", "legendFormat": "{{pool}}"}],
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8}
    },
    {
      "id": 4,
      "title": "Event-loop lag",
      "type": "timeseries",
      "targets": [{"refId": "A", "expr": "biddingflow_event_loop_lag_seconds", "legendFormat": "lag"}],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 8}
    },
    {
      "id": 5,
      "title": "PostgreSQL database size",
      "type": "timeseries",
      "targets": [
        {"refId": "A", "expr": "biddingflow_postgres_database_bytes", "legendFormat": "database bytes"}
      ],
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 8}
    },
    {
      "id": 6,
      "title": "Backup age",
      "type": "stat",
      "targets": [{"refId": "A", "expr": "biddingflow_backup_age_seconds"}],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 16}
    },
    {
      "id": 7,
      "title": "Restore-drill age",
      "type": "stat",
      "targets": [{"refId": "A", "expr": "biddingflow_restore_drill_age_seconds"}],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 6, "w": 6, "x": 6, "y": 16}
    },
    {
      "id": 8,
      "title": "Disk free ratio",
      "type": "timeseries",
      "targets": [{"refId": "A", "expr": "biddingflow_disk_free_bytes / biddingflow_disk_total_bytes", "legendFormat": "{{volume}}"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []},
      "gridPos": {"h": 6, "w": 12, "x": 12, "y": 16}
    },
    {
      "id": 9,
      "title": "Partner upstream outcomes",
      "type": "timeseries",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (upstream, outcome) (rate(biddingflow_partner_upstream_requests_total[5m]))",
          "legendFormat": "{{upstream}} / {{outcome}}"
        }
      ],
      "gridPos": {"h": 7, "w": 24, "x": 0, "y": 22}
    },
    {
      "id": 10,
      "title": "Durable queue state",
      "type": "timeseries",
      "targets": [
        {
          "refId": "A",
          "expr": "max by (queue, status) (biddingflow_background_jobs)",
          "legendFormat": "{{queue}} / {{status}}"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 29}
    },
    {
      "id": 11,
      "title": "Queue oldest job",
      "type": "timeseries",
      "targets": [
        {
          "refId": "A",
          "expr": "max by (queue, status) (biddingflow_background_job_oldest_seconds{status=~\"pending|retry|processing\"})",
          "legendFormat": "{{queue}} / {{status}}"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 29}
    },
    {
      "id": 12,
      "title": "PostgreSQL health",
      "type": "timeseries",
      "targets": [
        {"refId": "A", "expr": "max by (stat) (biddingflow_postgres_stat{stat=~\"deadlocks|conflicts|xact_rollback\"})", "legendFormat": "{{stat}}"},
        {"refId": "B", "expr": "max(biddingflow_postgres_waiting_locks)", "legendFormat": "waiting locks"},
        {"refId": "C", "expr": "max(biddingflow_postgres_pool_value{stat=\"requests_waiting\"})", "legendFormat": "pool waiters"}
      ],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 37}
    },
    {
      "id": 13,
      "title": "Worker resources",
      "type": "timeseries",
      "targets": [
        {"refId": "A", "expr": "rate(biddingflow_process_cpu_seconds_total[5m])", "legendFormat": "CPU {{instance}}"},
        {"refId": "B", "expr": "biddingflow_process_resident_memory_bytes", "legendFormat": "RAM {{instance}}"},
        {"refId": "C", "expr": "biddingflow_process_open_descriptors", "legendFormat": "FD/handles {{instance}}"}
      ],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 37}
    },
    {
      "id": 14,
      "title": "WebSocket cluster and broker",
      "type": "timeseries",
      "targets": [
        {"refId": "A", "expr": "max(biddingflow_websocket_cluster_active_connections)", "legendFormat": "cluster connections"},
        {"refId": "B", "expr": "max(biddingflow_websocket_outbox_oldest_seconds)", "legendFormat": "oldest broker event (s)"}
      ],
      "gridPos": {"h": 7, "w": 24, "x": 0, "y": 45}
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": ["biddingflow", "production"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "browser",
  "title": "BiddingFlow Production Overview",
  "uid": "biddingflow-production",
  "version": 2
}
