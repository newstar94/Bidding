[Unit]
Description=Create and verify a BiddingFlow full-state backup
Documentation=file:/opt/biddingflow/scripts/full_state_backup.py
After=local-fs.target
RequiresMountsFor=/var/lib/biddingflow /var/backups/biddingflow

[Service]
Type=oneshot
User=biddingflow
Group=biddingflow
WorkingDirectory=/opt/biddingflow
EnvironmentFile=/etc/biddingflow/biddingflow.env
# Only the service-control commands run with elevated credentials. The actual
# backup still runs as the dedicated `biddingflow` account.
ExecStartPre=+/usr/bin/systemctl stop biddingflow.service
ExecStart=/opt/biddingflow/.venv/bin/python /opt/biddingflow/scripts/full_state_backup.py create
ExecStopPost=+/usr/bin/systemctl start biddingflow.service
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/lib/biddingflow/uploads /var/lib/biddingflow/word-templates
ReadWritePaths=/var/lib/biddingflow/database /var/backups/biddingflow
