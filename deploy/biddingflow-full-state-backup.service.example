[Unit]
Description=Create and verify a BiddingFlow full-state backup
Documentation=file:/opt/biddingflow/scripts/backup.py
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/var/lib/biddingflow /var/backups/biddingflow

[Service]
Type=oneshot
User=biddingflow
Group=biddingflow
WorkingDirectory=/opt/biddingflow
EnvironmentFile=/etc/biddingflow/biddingflow.env
# pg_dump creates an online, transactionally consistent snapshot; web workers
# remain available for the entire backup.
ExecStart=/opt/biddingflow/.venv/bin/python /opt/biddingflow/scripts/backup.py create
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/lib/biddingflow/uploads /var/lib/biddingflow/word-templates
ReadWritePaths=/var/backups/biddingflow
