# Production reverse proxy for a same-host Cloudflare Tunnel deployment.
# cloudflared connects to 127.0.0.1:8080; Uvicorn listens on 127.0.0.1:8000.
# Do not expose either port through the host firewall.

limit_req_zone $binary_remote_addr zone=bf_api:10m rate=20r/s;
limit_req_zone $binary_remote_addr zone=bf_auth:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=bf_expensive:10m rate=6r/m;
limit_conn_zone $binary_remote_addr zone=bf_per_ip:10m;

map $http_upgrade $bf_connection_upgrade {
    default upgrade;
    "" close;
}

upstream biddingflow_app {
    server 127.0.0.1:8000;
    keepalive 32;
}

server {
    listen 127.0.0.1:8080 default_server;
    server_name _;

    # Safe only because this listener is loopback-only and cloudflared is the
    # sole production client. Never copy this trust rule to a public listener.
    set_real_ip_from 127.0.0.1;
    real_ip_header CF-Connecting-IP;
    real_ip_recursive off;

    client_max_body_size 27m;
    client_header_timeout 10s;
    client_body_timeout 20s;
    keepalive_timeout 15s;
    send_timeout 60s;
    reset_timedout_connection on;
    limit_req_status 429;
    limit_conn_status 429;

    location = /health/live {
        allow 127.0.0.1;
        deny all;
        proxy_pass http://biddingflow_app;
    }

    location = /health/ready {
        allow 127.0.0.1;
        deny all;
        proxy_pass http://biddingflow_app;
    }

    location = /metrics {
        allow 127.0.0.1;
        deny all;
        proxy_pass http://biddingflow_app;
    }

    location ~ ^/api/auth/(?:login|register|forgot-password|resend-code|verify)$ {
        limit_req zone=bf_auth burst=5 nodelay;
        limit_conn bf_per_ip 8;
        proxy_pass http://biddingflow_app;
        include /etc/nginx/snippets/biddingflow-proxy-params.conf;
    }

    location ~ ^/api/(?:export|import-excel|templates/upload|packages/.*/documents) {
        limit_req zone=bf_expensive burst=3 nodelay;
        limit_conn bf_per_ip 4;
        proxy_pass http://biddingflow_app;
        include /etc/nginx/snippets/biddingflow-proxy-params.conf;
    }

    location /api/ {
        limit_req zone=bf_api burst=40 nodelay;
        limit_conn bf_per_ip 20;
        proxy_pass http://biddingflow_app;
        include /etc/nginx/snippets/biddingflow-proxy-params.conf;
    }

    location = /ws/sync {
        limit_conn bf_per_ip 10;
        proxy_pass http://biddingflow_app;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $bf_connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 3s;
        proxy_read_timeout 75s;
        proxy_send_timeout 20s;
        proxy_buffering off;
    }

    location / {
        proxy_pass http://biddingflow_app;
        include /etc/nginx/snippets/biddingflow-proxy-params.conf;
    }
}
