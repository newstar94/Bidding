# Non-secret production overlay. Replace the exact domain everywhere, then put
# the real widget keys in the deployment secret manager. Never commit the
# rendered environment file or either Turnstile credential.
APP_ENV=production
APP_PUBLIC_URL=https://REPLACE_WITH_PRODUCTION_DOMAIN
ALLOWED_HOSTS=REPLACE_WITH_PRODUCTION_DOMAIN
CORS_ORIGINS=https://REPLACE_WITH_PRODUCTION_DOMAIN
ALLOWED_WS_ORIGINS=https://REPLACE_WITH_PRODUCTION_DOMAIN

# Same-host NGINX is the application's only direct proxy peer. cloudflared
# connects to NGINX on 127.0.0.1:8080 and must never connect to Uvicorn directly.
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=REPLACE_WITH_PRODUCTION_TURNSTILE_SITE_KEY
TURNSTILE_SECRET_KEY=REPLACE_WITH_PRODUCTION_TURNSTILE_SECRET_KEY
TURNSTILE_ALLOWED_HOSTNAMES=REPLACE_WITH_PRODUCTION_DOMAIN
TURNSTILE_VERIFY_TIMEOUT_SECONDS=5
TURNSTILE_LOGIN_AFTER_ATTEMPTS=3
TURNSTILE_VERIFY_AFTER_ATTEMPTS=3
TURNSTILE_EDGE_CHALLENGE_HEADER=X-BiddingFlow-Edge-Risk
TURNSTILE_EDGE_CHALLENGE_VALUE=challenge
