# Staging must use its own Managed widget. Do not reuse production credentials
# and do not use Cloudflare test keys on a public staging hostname.
APP_ENV=staging
APP_PUBLIC_URL=https://REPLACE_WITH_STAGING_DOMAIN
ALLOWED_HOSTS=REPLACE_WITH_STAGING_DOMAIN
CORS_ORIGINS=https://REPLACE_WITH_STAGING_DOMAIN
ALLOWED_WS_ORIGINS=https://REPLACE_WITH_STAGING_DOMAIN

TURNSTILE_ENABLED=auto
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=REPLACE_WITH_STAGING_DOMAIN
TURNSTILE_VERIFY_TIMEOUT_SECONDS=5
TURNSTILE_LOGIN_AFTER_ATTEMPTS=3
TURNSTILE_VERIFY_AFTER_ATTEMPTS=3
TURNSTILE_EDGE_CHALLENGE_HEADER=
TURNSTILE_EDGE_CHALLENGE_VALUE=
