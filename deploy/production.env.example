# BiddingFlow production web-process configuration
#
# Only deployment-specific values and production startup attestations are
# listed here. Runtime tuning uses code defaults. Add an override from
# environment-variables.reference only after measuring a concrete need.

APP_ENV=production
APP_RELEASE_ID=replace-with-release-id
APP_DEBUG=False
APP_SECURE_COOKIES=True
APP_PUBLIC_URL=https://REPLACE_WITH_PRODUCTION_DOMAIN
ALLOWED_HOSTS=REPLACE_WITH_PRODUCTION_DOMAIN
CORS_ORIGINS=https://REPLACE_WITH_PRODUCTION_DOMAIN
ALLOWED_WS_ORIGINS=https://REPLACE_WITH_PRODUCTION_DOMAIN
SUPER_ADMIN_IP_ALLOWLIST=
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
APP_INSTANCE_COUNT=1

# Runtime database credential only. Migration, backup and document-worker
# credentials belong in their own job/service environments.
DATABASE_URL=
DATABASE_SSLMODE=verify-full
DATABASE_AUTO_MIGRATE=false
DATABASE_PRIVATE_NETWORK_CONFIRMED=false

# First production bootstrap only. Once a user exists, these values are no
# longer required by startup; remove ADMIN_PASSWORD after bootstrap.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
ADMIN_EMAIL=REPLACE_WITH_PRODUCTION_ADMIN_EMAIL
DEFAULT_ORG_NAME=HCP

# Production email delivery. SMTP port/security/timeout defaults are documented
# in environment-variables.reference and may be overridden when needed.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER=
SMTP_SECURITY=starttls
EMAIL_OUTBOX_ENCRYPTION_KEY=
OTP_HMAC_KEY=

# Operational evidence/secrets required by production startup.
BIDDING_DATA_DIR=/var/lib/biddingflow
DATA_AT_REST_ENCRYPTION_CONFIRMED=false
SECRET_ROTATION_CONFIRMED_AT=
AUDIT_CHECKPOINT_HMAC_KEY=
AUDIT_CHECKPOINT_OFFHOST_CONFIRMED=false
BIDDING_RESTORE_DRILL_PUBLIC_KEY=
SYNC_CURSOR_SIGNING_KEY=
AWARD_RESULT_ARTIFACT_SHARED_STORAGE_CONFIRMED=false

# Observability/privacy controls. Detailed limits and endpoints stay in the
# exhaustive reference.
METRICS_ENABLED=true
STRUCTURED_REQUEST_LOG_MODE=errors
LOG_INCLUDE_EXCEPTION_DETAILS=false

# Production web workers enqueue document jobs. The standalone worker must use
# a separate least-privilege environment as documented in deploy/README.md.
DOCUMENT_WORKER_EXECUTION_MODE=external
DOCUMENT_WORKER_SHARED_GID=987
DOCUMENT_WORKER_TEMP_DIR=/var/lib/biddingflow-document-jobs
DOCUMENT_WORKER_SERVICE_ACCOUNT_CONFIRMED=false
DOCUMENT_WORKER_SHARED_STORAGE_CONFIRMED=false

# Optional Cloudflare Turnstile. In auto mode it remains disabled until all
# three values are present and valid.
TURNSTILE_ENABLED=auto
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=REPLACE_WITH_PRODUCTION_DOMAIN
TURNSTILE_LOGIN_AFTER_ATTEMPTS=3
TURNSTILE_VERIFY_AFTER_ATTEMPTS=3

# Login session and OTP policy (choose values deliberately for the deployment)
SESSION_EXPIRY_HOURS=4
SESSION_REMEMBER_EXPIRY_HOURS=24
SESSION_INACTIVITY_TIMEOUT_HOURS=10
SESSION_ACTIVITY_TOUCH_SECONDS=300
SESSION_RETENTION_DAYS=30
EMAIL_CHANGE_OTP_TTL_SECONDS=600
EMAIL_CHANGE_REQUEST_MAX=3
EMAIL_CHANGE_REQUEST_WINDOW_SECONDS=900
EMAIL_CHANGE_VERIFY_MAX=5
EMAIL_CHANGE_VERIFY_WINDOW_SECONDS=600
PRIVILEGED_REAUTH_TTL_SECONDS=600
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_WINDOW_SECONDS=60

# Durable conflict center (keys are required only when enabled)
CONFLICT_CENTER_ENABLED=false
CONFLICT_DRAFT_ENCRYPTION_KEY=
CONFLICT_RESOLUTION_SIGNING_KEY=

# Mua Sam Cong lookup/import is enabled by code and defaults to the official
# provider. The reCAPTCHA value is the upstream public site identifier,
# distinct from this application's private Turnstile secret.
# Default browser adapter for the exact official Mua Sắm Công host.
PROCUREMENT_BROWSER_MODE=research-stealth
RESEARCH_STEALTH_ENABLED=true
RESEARCH_STEALTH_ALLOWED_TARGET_HOSTS=muasamcong.mpi.gov.vn
MUASAMCONG_RECAPTCHA_SITE_KEY=6LeQH9gpAAAAAPpzhkvYzd8QCrP-QyLVRSw_SD9U

# Backend AI assistant
AI_ENABLED=false
AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=
AI_PROVIDER_ALLOWED_HOSTS=
AI_MODEL=gpt-5.6
AI_KNOWLEDGE_ENABLED=true
AI_PROVIDER_STORE_RESPONSES=false
AI_DAILY_REQUEST_LIMIT=100
AI_DAILY_TOKEN_LIMIT=100000
AI_WEB_SEARCH_ENABLED=false
AI_WEB_SEARCH_PROVIDER=gemini_grounding
AI_WEB_SEARCH_API_KEY=
AI_WEB_SEARCH_MODEL=
AI_WEB_SEARCH_ALLOWED_DOMAINS=vanban.chinhphu.vn,vbpl.vn,muasamcong.gov.vn,muasamcong.mpi.gov.vn

# Google sign-in
GOOGLE_AUTH_ENABLED=auto
GOOGLE_CLIENT_ID=

# Commercial/payment controls. Keep trial choice explicit for this deployment.
TRIAL_FULL_ACCESS_ENABLED=false
COMMERCIAL_POLICY_ENABLED=false
COMMERCIAL_POLICY_MODE=off
PAYMENT_CHECKOUT_ENABLED=false
PAYMENT_ACTIVATION_ENABLED=false
PROCUREMENT_CREDIT_ENFORCEMENT_ENABLED=false
COMMERCIAL_PAYMENT_PROVIDER=fake
PAYMENT_PROVIDER_ENVIRONMENT=production
COMMERCIAL_EXTERNAL_LEGAL_READY=false
PAYOS_MERCHANT_AUTHORIZATION_CONFIRMED=false
PAYOS_WEBHOOK_AUTHORIZATION_CONFIRMED=false
# Non-secret pointer that must match the immutable PayOS provider profile in
# the database. This is not the merchant Client ID.
PAYOS_CREDENTIAL_REFERENCE=env://payos/default
# Real PayOS merchant credentials; inject values through the secret manager.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# Other non-tuning feature switches
VERSION_COMPARISON_ENABLED=false
LEGAL_VERSIONING_ENABLED=false
AI_COMPLIANCE_ENABLED=false
WORD_TEMPLATE_CATALOG_ENABLED=false
WORD_TEMPLATE_CATALOG_MODE=shadow
BIDDING_WORD_TEMPLATE_CATALOG_DIR=/var/lib/biddingflow/templates/word-catalog
