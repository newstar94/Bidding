# Cấu hình SMTP để gửi email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_SENDER=your-email@gmail.com

# Cấu hình máy chủ ứng dụng
APP_HOST=127.0.0.1
APP_PORT=8000
APP_ENV=production
# CẢNH BÁO: Đặt APP_DEBUG=False trên production!
APP_DEBUG=False
APP_SECURE_COOKIES=True

# Cấu hình admin khi khởi tạo lần đầu.
# ADMIN_PASSWORD bắt buộc phải đặt; server sẽ fail-fast nếu để trống.
ADMIN_PASSWORD=your_strong_password_here
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@localhost
DEFAULT_ORG_NAME=HTD

# So vong PBKDF2-SHA256 cho mat khau moi/doi mat khau moi.
PASSWORD_HASH_ITERATIONS=310000

# CORS: Cho phép các origin truy cập API (phân tách bằng dấu phẩy)
# Ví dụ production: CORS_ORIGINS=https://yourdomain.com
CORS_ORIGINS=https://yourdomain.com
ALLOWED_WS_ORIGINS=https://yourdomain.com

# Cho phép superadmin truy cập thao tác từ mọi IP ngoài mạng nội bộ (Dùng * để cho phép tất cả)
SUPER_ADMIN_IP_ALLOWLIST=127.0.0.1

# Thời gian hết hạn phiên đăng nhập mặc định khi không chọn Ghi nhớ (tính bằng giờ)
SESSION_EXPIRY_HOURS=4

# Thời gian hết hạn phiên đăng nhập khi tích chọn Ghi nhớ đăng nhập (tính bằng giờ)
SESSION_REMEMBER_EXPIRY_HOURS=24

# Thời gian treo máy tối đa trên trình duyệt trước khi tự động đăng xuất (tính bằng giờ)
SESSION_INACTIVITY_TIMEOUT_HOURS=10

# Google OAuth 2.0 (Dang nhap bang Google)
# Google Cloud Console > OAuth Client > Authorized JavaScript origins phai khai bao dung origin dang mo app.
# Vi du local can khai bao rieng tung origin: http://127.0.0.1:8000 va http://localhost:8000
# Production phai dung HTTPS origin that, khong kem path.
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
