# BiddingFlow local development profile
#
# Copy this file to .env, then run `python scripts/setup_local_postgres.py`.
# Feature switches, credentials and auth policy stay visible here. Timeout,
# queue, pool and cache tuning remain in deploy/environment-variables.reference.

APP_ENV=development
APP_DEBUG=true
FRONTEND_ASSET_MODE=bundle

# Database and first-run account
DATABASE_URL=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@localhost
DEFAULT_ORG_NAME=HCP

# SMTP (host/port/security use code defaults unless overridden)
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER=
EMAIL_OUTBOX_ENCRYPTION_KEY=

# Login session policy
SESSION_EXPIRY_HOURS=4
SESSION_REMEMBER_EXPIRY_HOURS=24
SESSION_INACTIVITY_TIMEOUT_HOURS=10
SESSION_ACTIVITY_TOUCH_SECONDS=300
SESSION_RETENTION_DAYS=30

# Registration and email-change OTP
OTP_HMAC_KEY=
EMAIL_CHANGE_OTP_TTL_SECONDS=600
EMAIL_CHANGE_REQUEST_MAX=3
EMAIL_CHANGE_REQUEST_WINDOW_SECONDS=900
EMAIL_CHANGE_VERIFY_MAX=5
EMAIL_CHANGE_VERIFY_WINDOW_SECONDS=600

# Authentication policy
PRIVILEGED_REAUTH_TTL_SECONDS=600
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_WINDOW_SECONDS=60

# Durable conflict center (keys are required only when enabled)
CONFLICT_CENTER_ENABLED=false
CONFLICT_DRAFT_ENCRYPTION_KEY=
CONFLICT_RESOLUTION_SIGNING_KEY=

# Cloudflare Turnstile (disabled until explicitly enabled and keyed)
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=localhost,127.0.0.1
TURNSTILE_LOGIN_AFTER_ATTEMPTS=3
TURNSTILE_VERIFY_AFTER_ATTEMPTS=3

# Mua Sam Cong lookup/import
PROCUREMENT_LOOKUP_ENABLED=false
PROCUREMENT_PROVIDER=muasamcong
PROCUREMENT_IMPORT_ENABLED=false
PROCUREMENT_BROWSER_MODE=standard
RESEARCH_STEALTH_ENABLED=false
RESEARCH_STEALTH_ALLOWED_TARGET_HOSTS=muasamcong.mpi.gov.vn
# Public reCAPTCHA identifier used by muasamcong.mpi.gov.vn.
MUASAMCONG_RECAPTCHA_SITE_KEY=6LeQH9gpAAAAAPpzhkvYzd8QCrP-QyLVRSw_SD9U

# Backend AI assistant (keys remain server-side)
AI_ENABLED=false
AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=
AI_PROVIDER_ALLOWED_HOSTS=
AI_MODEL=gpt-5.6
AI_KNOWLEDGE_ENABLED=true
AI_PROVIDER_STORE_RESPONSES=false
AI_DAILY_REQUEST_LIMIT=100
AI_DAILY_TOKEN_LIMIT=100000
AI_WEB_SEARCH_ENABLED=false
AI_WEB_SEARCH_PROVIDER=gemini_grounding
AI_WEB_SEARCH_API_KEY=
AI_WEB_SEARCH_MODEL=
AI_WEB_SEARCH_ALLOWED_DOMAINS=vanban.chinhphu.vn,vbpl.vn,muasamcong.gov.vn,muasamcong.mpi.gov.vn

# Google sign-in
GOOGLE_AUTH_ENABLED=auto
GOOGLE_CLIENT_ID=

# Commercial/payment controls. Choose the trial mode explicitly:
# true = full trial entitlements for already-authorized workspaces;
# false = use the commercial policy flags below.
TRIAL_FULL_ACCESS_ENABLED=
COMMERCIAL_POLICY_ENABLED=false
COMMERCIAL_POLICY_MODE=off
PAYMENT_CHECKOUT_ENABLED=false
PAYMENT_ACTIVATION_ENABLED=false
PROCUREMENT_CREDIT_ENFORCEMENT_ENABLED=false
COMMERCIAL_PAYMENT_PROVIDER=fake
PAYMENT_PROVIDER_ENVIRONMENT=production
COMMERCIAL_EXTERNAL_LEGAL_READY=false
PAYOS_MERCHANT_AUTHORIZATION_CONFIRMED=false
PAYOS_WEBHOOK_AUTHORIZATION_CONFIRMED=false
# Non-secret pointer that must match the immutable PayOS provider profile in
# the database. This is not the merchant Client ID.
PAYOS_CREDENTIAL_REFERENCE=env://payos/default
# Real PayOS merchant credentials; inject values outside source control.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# Other non-tuning feature switches
VERSION_COMPARISON_ENABLED=true
LEGAL_VERSIONING_ENABLED=false
AI_COMPLIANCE_ENABLED=false
WORD_EXPORT_STANDARDIZATION_MODE=apply_safe
WORD_TEMPLATE_CATALOG_ENABLED=false
WORD_TEMPLATE_CATALOG_MODE=shadow

# Optional local persistent root; runtime subdirectories derive from it.
# BIDDING_DATA_DIR=data
