# BIDDINGFLOW — CẤU HÌNH MÔI TRƯỜNG
# Bản tinh gọn: AI và tra cứu dùng mặc định trong code khi không khai báo override.
# Tìm kiếm AI kế thừa khóa/model khi phù hợp; nếu dùng dịch vụ hoặc model khác,
# thêm AI_WEB_SEARCH_API_KEY và AI_WEB_SEARCH_MODEL theo tài liệu nâng cao.
# Hướng dẫn và danh sách override: docs/env-simplification-review.md.
# File .env.example: các biến được nhóm theo chức năng, chú thích đặt ngay trên từng biến.
# Không đưa mật khẩu, khóa API hoặc chuỗi kết nối thật vào mã nguồn hay frontend.
# Dòng bắt đầu bằng # là chú thích; biến có # phía trước chưa được kích hoạt.
# Khi đổi giá trị, kiểm tra yêu cầu khởi động lại web/worker và cấu hình thực tế có hiệu lực.
# Đổi tên miền cần đối chiếu APP_PUBLIC_URL, ALLOWED_HOSTS, CORS, CSRF, WebSocket và Turnstile.
# Tham số nâng cao về hàng đợi, pool, cache và thời gian chờ: deploy/environment-variables.reference.
# Mẫu phát triển cục bộ: sao chép thành .env, rồi chạy python scripts/setup_local_postgres.py.
# Không sao chép khóa thật từ .env vào file mẫu; các biến riêng từng môi trường có thể khác nhau.

# ============================================================================
# 01. ỨNG DỤNG VÀ LƯU TRỮ
# ============================================================================

# Môi trường chạy ứng dụng.
APP_ENV=development

# Chế độ gỡ lỗi; phải tắt trên môi trường vận hành chính thức.
APP_DEBUG=true

# Chế độ tài nguyên giao diện; cấu hình này còn chịu ràng buộc bởi APP_DEBUG.
FRONTEND_ASSET_MODE=bundle

# Thư mục dữ liệu bền vững; các thư mục dữ liệu con được suy ra từ đây.
# BIDDING_DATA_DIR=data


# ============================================================================
# 03. POSTGRESQL — KẾT NỐI VÀ TÀI KHOẢN DỊCH VỤ
# ============================================================================

# Chuỗi kết nối cơ sở dữ liệu ứng dụng; có thể chứa mật khẩu, phải giữ bí mật.
DATABASE_URL=


# ============================================================================
# 06. KHỞI TẠO QUẢN TRỊ VÀ ĐƠN VỊ
# ============================================================================

# Tên đăng nhập quản trị khi khởi tạo lần đầu.
ADMIN_USERNAME=admin

# Mật khẩu quản trị khởi tạo; giữ bí mật, không dùng để đổi mật khẩu tài khoản đã có.
ADMIN_PASSWORD=

# Tên hiển thị của tài khoản quản trị khởi tạo.
ADMIN_NAME=Administrator

# Địa chỉ email của tài khoản quản trị khởi tạo.
ADMIN_EMAIL=admin@localhost

# Tên đơn vị mặc định khi khởi tạo.
DEFAULT_ORG_NAME=HCP


# ============================================================================
# 07. GỬI EMAIL
# ============================================================================

# Tài khoản đăng nhập máy chủ gửi email.
SMTP_USER=

# Mật khẩu SMTP; giữ bí mật.
SMTP_PASSWORD=

# Địa chỉ người gửi email.
SMTP_SENDER=

# Khóa mã hóa hàng đợi email; giữ bí mật, không tự ý thay khi còn dữ liệu mã hóa.
EMAIL_OUTBOX_ENCRYPTION_KEY=


# ============================================================================
# 08. PHIÊN ĐĂNG NHẬP VÀ GIỚI HẠN XÁC THỰC
# ============================================================================

# Thời hạn phiên đăng nhập thông thường, tính bằng giờ.
SESSION_EXPIRY_HOURS=4

# Thời hạn phiên khi chọn ghi nhớ đăng nhập, tính bằng giờ.
SESSION_REMEMBER_EXPIRY_HOURS=24

# Thời gian không hoạt động trước khi hết phiên, tính bằng giờ.
SESSION_INACTIVITY_TIMEOUT_HOURS=10

# Khoảng cập nhật dấu thời gian hoạt động phiên, tính bằng giây.
SESSION_ACTIVITY_TOUCH_SECONDS=300

# Thời gian lưu giữ phiên phục vụ dọn dẹp, tính bằng ngày.
SESSION_RETENTION_DAYS=30

# Thời hạn hiệu lực xác thực lại cho thao tác đặc quyền, tính bằng giây.
PRIVILEGED_REAUTH_TTL_SECONDS=600

# Số lần thử tối đa trong cửa sổ giới hạn xác thực.
RATE_LIMIT_MAX_ATTEMPTS=5

# Độ dài cửa sổ giới hạn xác thực, tính bằng giây.
RATE_LIMIT_WINDOW_SECONDS=60


# ============================================================================
# 09. OTP VÀ THAY ĐỔI EMAIL
# ============================================================================

# Khóa HMAC bảo vệ mã OTP; giữ bí mật.
OTP_HMAC_KEY=

# Thời hạn mã OTP đổi email, tính bằng giây.
EMAIL_CHANGE_OTP_TTL_SECONDS=600

# Số yêu cầu đổi email tối đa trong một cửa sổ giới hạn.
EMAIL_CHANGE_REQUEST_MAX=3

# Cửa sổ giới hạn yêu cầu đổi email, tính bằng giây.
EMAIL_CHANGE_REQUEST_WINDOW_SECONDS=900

# Số lần xác minh đổi email tối đa trong một cửa sổ giới hạn.
EMAIL_CHANGE_VERIFY_MAX=5

# Cửa sổ giới hạn xác minh đổi email, tính bằng giây.
EMAIL_CHANGE_VERIFY_WINDOW_SECONDS=600


# ============================================================================
# 10. ĐĂNG NHẬP GOOGLE
# ============================================================================

# Bật hoặc tắt đăng nhập bằng Google.
GOOGLE_AUTH_ENABLED=auto

# Mã ứng dụng OAuth của Google.
GOOGLE_CLIENT_ID=


# ============================================================================
# 11. CLOUDFLARE TURNSTILE
# ============================================================================

# Chế độ Turnstile; chỉ bật khi khóa và tên miền phù hợp với môi trường.
TURNSTILE_ENABLED=false

# Khóa công khai của widget Turnstile; khóa thử nghiệm không thay thế khóa vận hành chính thức.
TURNSTILE_SITE_KEY=

# Khóa bí mật xác minh Turnstile; chỉ giữ ở máy chủ.
TURNSTILE_SECRET_KEY=

# Các hostname được chấp nhận trong kết quả Turnstile.
TURNSTILE_ALLOWED_HOSTNAMES=localhost,127.0.0.1

# Ngưỡng số lần thử đăng nhập trước khi yêu cầu Turnstile.
TURNSTILE_LOGIN_AFTER_ATTEMPTS=3

# Ngưỡng số lần thử xác minh trước khi yêu cầu Turnstile.
TURNSTILE_VERIFY_AFTER_ATTEMPTS=3


# ============================================================================
# 12. TRA CỨU VÀ NHẬP DỮ LIỆU ĐẤU THẦU
# ============================================================================




# Mã site reCAPTCHA công khai của nguồn tích hợp, không phải khóa Turnstile của ứng dụng.
MUASAMCONG_RECAPTCHA_SITE_KEY=6LeQH9gpAAAAAPpzhkvYzd8QCrP-QyLVRSw_SD9U


# ============================================================================
# 13. TRỢ LÝ AI
# ============================================================================

# Bật hoặc tắt trợ lý AI phía máy chủ.
AI_ENABLED=false

# Nhà cung cấp AI; fake dành cho mô phỏng, nhà cung cấp thật cần cấu hình tương ứng.
AI_PROVIDER=openai

# Tên mô hình AI sử dụng.
AI_MODEL=gpt-5.6

# Khóa API của nhà cung cấp AI; chỉ giữ ở máy chủ.
AI_API_KEY=








# ============================================================================
# 14. TÌM KIẾM WEB CHO AI
# ============================================================================

# Bật hoặc tắt tìm kiếm web cho AI.
AI_WEB_SEARCH_ENABLED=false






# ============================================================================
# 15. XUNG ĐỘT ĐỒNG BỘ
# ============================================================================

# Bật hoặc tắt trung tâm giải quyết xung đột.
CONFLICT_CENTER_ENABLED=false

# Khóa mã hóa bản nháp xung đột; giữ bí mật, không tự ý đổi khi còn bản nháp.
CONFLICT_DRAFT_ENCRYPTION_KEY=

# Khóa ký quyết định giải quyết xung đột; giữ bí mật.
CONFLICT_RESOLUTION_SIGNING_KEY=


# ============================================================================
# 16. PHIÊN BẢN VÀ TUÂN THỦ
# ============================================================================

# Bật hoặc tắt chức năng so sánh phiên bản.
VERSION_COMPARISON_ENABLED=true

# Bật hoặc tắt chức năng phiên bản pháp lý.
LEGAL_VERSIONING_ENABLED=false

# Bật hoặc tắt chức năng AI hỗ trợ tuân thủ.
AI_COMPLIANCE_ENABLED=false


# ============================================================================
# 17. XUẤT WORD VÀ DANH MỤC BIỂU MẪU
# ============================================================================


# Bật hoặc tắt danh mục biểu mẫu Word.
WORD_TEMPLATE_CATALOG_ENABLED=false

# Chế độ danh mục biểu mẫu: shadow hoặc cutover.
WORD_TEMPLATE_CATALOG_MODE=shadow


# ============================================================================
# 18. DÙNG THỬ VÀ CHÍNH SÁCH THƯƠNG MẠI
# ============================================================================

# true: dùng thử toàn tính năng trong phạm vi đã có quyền; false: dùng chính sách thương mại. Không cấp thêm quyền đọc bản ghi.
TRIAL_FULL_ACCESS_ENABLED=false

# Bật hoặc tắt chính sách thương mại; còn chịu ảnh hưởng của chế độ dùng thử.
COMMERCIAL_POLICY_ENABLED=false

# Chế độ chính sách thương mại: off, shadow hoặc enforce.
COMMERCIAL_POLICY_MODE=off

# Bật hoặc tắt áp dụng hạn mức lượt tra cứu theo chính sách thương mại.
PROCUREMENT_CREDIT_ENFORCEMENT_ENABLED=false

# Xác nhận điều kiện pháp lý bên ngoài đã sẵn sàng; chỉ bật khi có bằng chứng.
COMMERCIAL_EXTERNAL_LEGAL_READY=false


# ============================================================================
# 19. THANH TOÁN VÀ TÍCH HỢP PAYOS
# ============================================================================

# Bật hoặc tắt luồng tạo thanh toán; chỉ bật khi các điều kiện triển khai đã đáp ứng.
PAYMENT_CHECKOUT_ENABLED=false

# Bật hoặc tắt kích hoạt từ thanh toán; không bật chỉ vì đã điền khóa.
PAYMENT_ACTIVATION_ENABLED=false

# Nhà cung cấp thanh toán thương mại.
COMMERCIAL_PAYMENT_PROVIDER=fake

# Môi trường của nhà cung cấp thanh toán.
PAYMENT_PROVIDER_ENVIRONMENT=production

# Tham chiếu không bí mật, phải khớp hồ sơ PayOS bất biến trong cơ sở dữ liệu; không phải Client ID.
PAYOS_CREDENTIAL_REFERENCE=env://payos/default

# Mã khách hàng merchant PayOS; cấp thông tin thật ngoài hệ thống quản lý mã nguồn.
PAYOS_CLIENT_ID=

# Khóa API PayOS; giữ bí mật.
PAYOS_API_KEY=

# Khóa kiểm tra chữ ký PayOS; giữ bí mật.
PAYOS_CHECKSUM_KEY=

# Xác nhận merchant đã cho phép tích hợp; chỉ bật khi đã hoàn tất xác nhận.
PAYOS_MERCHANT_AUTHORIZATION_CONFIRMED=false

# Xác nhận webhook đã được cho phép; chỉ bật khi đã hoàn tất xác nhận.
PAYOS_WEBHOOK_AUTHORIZATION_CONFIRMED=false
