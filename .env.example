# SMTP configuration for sending email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=REPLACE_WITH_SMTP_USER
SMTP_PASSWORD=
SMTP_SENDER=REPLACE_WITH_SMTP_SENDER
SMTP_SECURITY=starttls
SMTP_TIMEOUT_SECONDS=10
# Optional private CA bundle for an internal SMTP service. Public providers use
# the operating system trust store when this is empty.
# SMTP_CA_FILE=/etc/ssl/certs/internal-smtp-ca.pem

# Application server
# For production behind a reverse proxy, bind the app to an internal address.
# Public browser origins are configured below in CORS_ORIGINS and ALLOWED_WS_ORIGINS.
APP_HOST=127.0.0.1
APP_PORT=8000
APP_ENV=production
# Immutable release tag or full source revision included in backend logs and frontend diagnostics.
APP_RELEASE_ID=replace-with-release-id
APP_DEBUG=False
APP_SECURE_COOKIES=True
# REQUIRED: canonical production origin used for browser and one-time links.
# Replace the placeholder everywhere; do not include a trailing path.
APP_PUBLIC_URL=https://REPLACE_WITH_PRODUCTION_DOMAIN
# Exact HTTP Host allowlist. Production must contain only APP_PUBLIC_URL's
# hostname, without scheme, port or wildcard.
ALLOWED_HOSTS=REPLACE_WITH_PRODUCTION_DOMAIN

# Optional Cloudflare Turnstile. In auto mode, the application starts normally
# with CAPTCHA disabled until site key, secret key and exact hostname are all
# present and valid. Use true instead of auto only when CAPTCHA must fail closed.
TURNSTILE_ENABLED=auto
# Optional secrets: fill through the production secret manager to activate.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=REPLACE_WITH_PRODUCTION_DOMAIN
TURNSTILE_VERIFY_TIMEOUT_SECONDS=5
# Require Turnstile on the next login after this many unsuccessful attempts.
TURNSTILE_LOGIN_AFTER_ATTEMPTS=3
# Require Turnstile on the next email-verification attempt after this many tries.
TURNSTILE_VERIFY_AFTER_ATTEMPTS=3
# Optional escalation-only marker set/overwritten by an edge request-header
# transform for suspicious login traffic. It can require a CAPTCHA but can
# never bypass CAPTCHA or rate limits. Leave both empty to disable.
TURNSTILE_EDGE_CHALLENGE_HEADER=
TURNSTILE_EDGE_CHALLENGE_VALUE=

# Secure frontend build. Dead-code injection is not a security boundary and
# increases parse/debug cost, so production keeps it disabled by default.
ENABLE_JS_DEAD_CODE_INJECTION=false
# Debug protection can interfere with browser diagnostics and remains opt-in.
ENABLE_JS_DEBUG_PROTECTION=false

# PostgreSQL is the only supported database engine. Use a runtime role with no
# DDL privileges here; run schema initialization/upgrades with a separate
# migrator credential before starting the web workers.
# REQUIRED SECRET: full PostgreSQL runtime URL, stored outside the release.
DATABASE_URL=
# Extra comma-separated database names allowed for the destructive LP-25 E2E
# fixture. APP_ENV=test is always required; CI/local test names are built in.
LP25_DATABASE_ALLOWLIST=
DATABASE_RUNTIME_ROLE=biddingflow_app
DATABASE_SSLMODE=verify-full
# Required in production. Development and test startup automatically migrate
# when this setting is omitted; set it to false there to opt out.
DATABASE_AUTO_MIGRATE=false
DATABASE_AUTO_START_LOCAL=false
# Put these only in the isolated backup job environment, never web workers:
# DATABASE_BACKUP_ROLE=biddingflow_backup
# DATABASE_BACKUP_PASSWORD=replace-with-independent-secret
# BACKUP_DATABASE_URL=postgresql://biddingflow_backup:replace-with-independent-secret@postgres.example.internal:5432/biddingflow?sslmode=verify-full
# Put these only in /etc/biddingflow/document-worker.env, never web workers:
# DATABASE_DOCUMENT_WORKER_ROLE=biddingflow_document_worker
# DATABASE_DOCUMENT_WORKER_PASSWORD=replace-with-independent-secret
# DOCUMENT_WORKER_DATABASE_URL=postgresql://biddingflow_document_worker:replace-with-independent-secret@postgres.example.internal:5432/biddingflow?sslmode=verify-full
# Set true only after PostgreSQL listens exclusively on a private network and
# firewall/security-group rules admit only the application and migration jobs.
DATABASE_PRIVATE_NETWORK_CONFIRMED=false
DATABASE_POOL_MIN_SIZE=2
DATABASE_POOL_MAX_SIZE=8
# Keep these values aligned with the process manager and replica count. Startup
# refuses production when the declared cluster budget plus reserve reaches
# PostgreSQL max_connections.
APP_INSTANCE_COUNT=1
UVICORN_WORKERS=4
# These values are consumed by deploy/systemd/biddingflow.service.example.
# They are validated again during application startup.
UVICORN_LIMIT_CONCURRENCY=256
UVICORN_BACKLOG=512
UVICORN_TIMEOUT_KEEP_ALIVE=5
UVICORN_MAX_REQUESTS=10000
UVICORN_MAX_REQUESTS_JITTER=1000
UVICORN_WS_MAX_SIZE=65536
UVICORN_WS_MAX_QUEUE=16
DATABASE_DEDICATED_CONNECTIONS_PER_WORKER=1
DATABASE_RESERVED_CONNECTIONS=20
DATABASE_POOL_TIMEOUT_SECONDS=2
DATABASE_POOL_MAX_IDLE_SECONDS=300
DATABASE_POOL_MAX_LIFETIME_SECONDS=1800
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_LOCK_TIMEOUT_MS=2000
DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=30000
DATABASE_APPLICATION_NAME=biddingflow

# Mutable application assets use an absolute persistent volume independent of
# source code and PostgreSQL storage.
BIDDING_DATA_DIR=/var/lib/biddingflow
# Set true only after the DB, upload/template and backup paths below are on
# encrypted volumes (for example LUKS/dm-crypt, BitLocker or encrypted block storage).
DATA_AT_REST_ENCRYPTION_CONFIRMED=false
# ISO date of the last SMTP/OAuth/application-secret rotation. Production
# refuses to start when this attestation is missing or older than 90 days.
SECRET_ROTATION_CONFIRMED_AT=

# Backups default to BIDDING_DATA_DIR/backups and should be replicated to
# encrypted off-host/object storage by infrastructure after each successful run.
BIDDING_BACKUP_RETENTION_COUNT=14

# Mutable uploads, user Word templates, worker temp and logs are deliberately
# separate from the DB directory so they can use independent mounts/retention.
SYNC_TOMBSTONE_RETENTION_DAYS=90
SYNC_MUTATION_RETENTION_DAYS=30
# Each retention transaction deletes at most this many rows (bounded 1-10000).
RETENTION_CLEANUP_BATCH_SIZE=1000
API_IDEMPOTENCY_RETENTION_DAYS=7
PARTNER_JOB_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=3650
AUDIT_CHAIN_VERIFY_INTERVAL_SECONDS=300
AUDIT_CHECKPOINT_INTERVAL_SECONDS=86400
# Checkpoints default to BIDDING_DATA_DIR/audit-checkpoints. Override the path
# only when a separately protected local volume is available.
# Store this value in the production secret manager, never in source control.
AUDIT_CHECKPOINT_HMAC_KEY=
# Set true only after immutable/off-host replication is actually enabled.
AUDIT_CHECKPOINT_OFFHOST_CONFIRMED=false
# The restore job keeps the Ed25519 private key in its own secret scope. Web
# workers receive only the public key and must reject the private key.
BIDDING_RESTORE_DRILL_PRIVATE_KEY=
BIDDING_RESTORE_DRILL_PUBLIC_KEY=
BACKUP_MAX_RPO_SECONDS=93600
RESTORE_MAX_RTO_SECONDS=3600
OPERATIONAL_ARTIFACT_VERIFY_INTERVAL_SECONDS=900
# Uploads, mutable Word templates and document-worker temp default to
# BIDDING_DATA_DIR/templates/images, templates/words and document-worker-temp.

# Production web workers only enqueue and consume results. The dedicated
# systemd document-worker service claims jobs and launches each parser inside
# a disposable Bubblewrap sandbox. Development/test defaults to embedded.
DOCUMENT_WORKER_EXECUTION_MODE=external
DOCUMENT_WORKER_MAX_CONCURRENCY=2
DOCUMENT_WORKER_INSTANCE_COUNT=1
DOCUMENT_WORKER_QUEUE_TIMEOUT_SECONDS=2
DOCUMENT_WORKER_QUEUE_SIZE=2
DOCUMENT_WORKER_TIMEOUT_SECONDS=45
DOCUMENT_JOB_MAX_ATTEMPTS=2
DOCUMENT_JOB_STALE_SECONDS=240
DOCUMENT_JOB_RETENTION_SECONDS=86400
DOCUMENT_JOB_POLL_SECONDS=5
DOCUMENT_JOB_MAX_POLL_SECONDS=10
# Subtractive jitter desynchronizes worker instances without exceeding each
# queue's configured maximum pickup delay.
WORKER_IDLE_POLL_JITTER_RATIO=0.1
# Numeric GID of the dedicated biddingflow-documents group shared only by the
# web service and document-worker daemon. The exchange root is 0770; each
# disposable parser directory inside the worker remains 0700.
DOCUMENT_WORKER_SHARED_GID=987
DOCUMENT_WORKER_TEMP_DIR=/var/lib/biddingflow-document-jobs
AWARD_RESULT_ARTIFACT_SHARED_STORAGE_CONFIRMED=false
AWARD_RESULT_ARTIFACT_MAX_PER_USER=20
AWARD_RESULT_ARTIFACT_MAX_BYTES_PER_USER=104857600
AWARD_RESULT_ARTIFACT_MAX_PER_ORGANIZATION=200
AWARD_RESULT_ARTIFACT_MAX_BYTES_PER_ORGANIZATION=1073741824
AWARD_RESULT_ARTIFACT_MAX_GLOBAL_BYTES=2147483648
AWARD_RESULT_ARTIFACT_CLEANUP_INTERVAL_SECONDS=60
# Set both true only after installing the dedicated systemd account/service and
# mounting the shared exchange path on an encrypted volume visible to every
# application instance and document-worker instance.
DOCUMENT_WORKER_SERVICE_ACCOUNT_CONFIRMED=false
DOCUMENT_WORKER_SHARED_STORAGE_CONFIRMED=false
DOCUMENT_WORKER_CPU_SECONDS=40
DOCUMENT_WORKER_MAX_MEMORY_MB=768
DOCUMENT_WORKER_MAX_OUTPUT_MB=64
# Linux production: install bubblewrap and keep this mode. Bubblewrap creates a
# mount/PID/network namespace per job and does not mount `.env` or runtime data.
DOCUMENT_WORKER_SANDBOX=bwrap
DOCUMENT_WORKER_SANDBOX_EXECUTABLE=/usr/bin/bwrap
# Production Linux keeps both services non-root and requires Bubblewrap to map
# the daemon to a second identity before parsing.
DOCUMENT_WORKER_REQUIRE_PRIVILEGE_DROP=true
# Linux Bubblewrap maps the daemon UID/GID to this non-root identity only
# inside a fresh user namespace. Do not set either value to 0.
DOCUMENT_WORKER_SANDBOX_UID=65534
DOCUMENT_WORKER_SANDBOX_GID=65534

# Bounded pool for legacy/blocking network and small filesystem operations.
BLOCKING_IO_MAX_WORKERS=8
BLOCKING_IO_MAX_QUEUE=16

# Blocking DB work is isolated from the event loop. PostgreSQL permits multiple
# write workers; total processes × pool max must stay within the DB budget.
DATABASE_READ_WORKERS=8
DATABASE_READ_QUEUE=64
DATABASE_WRITE_WORKERS=4
DATABASE_WRITE_QUEUE=64

# PBKDF2 and other CPU-heavy request work use a separate bounded pool.
CPU_WORKER_COUNT=2
CPU_WORKER_QUEUE=8

# Independent Fernet key for encrypted durable email-outbox payloads. Generate:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this value in a secret manager and rotate it independently.
EMAIL_OUTBOX_ENCRYPTION_KEY=
EMAIL_OUTBOX_STALE_SECONDS=300
EMAIL_OUTBOX_POLL_SECONDS=5
EMAIL_OUTBOX_MAX_POLL_SECONDS=10

# Email-change step-up and OTP throttling.
EMAIL_CHANGE_OTP_TTL_SECONDS=600
EMAIL_CHANGE_REQUEST_MAX=3
EMAIL_CHANGE_REQUEST_WINDOW_SECONDS=900
EMAIL_CHANGE_VERIFY_MAX=5
EMAIL_CHANGE_VERIFY_WINDOW_SECONDS=600

# Actual ASGI stream limits (the reverse proxy must be at least as strict).
REQUEST_MAX_JSON_BYTES=1048576
REQUEST_MAX_SYNC_BYTES=10485760
# Includes multipart overhead; each DOCX/XLSX file remains limited to 10MB.
REQUEST_MAX_DOCUMENT_BYTES=11534336
# Includes multipart overhead; each package document remains limited to 25MiB.
REQUEST_MAX_PACKAGE_DOCUMENT_BYTES=27262976
SYNC_MAX_BATCH_ITEMS=2000
EXCEL_MAX_IMPORT_ROWS=10000

# WebSocket quotas. Keep WEBSOCKET_MAX_FRAME_BYTES equal to Uvicorn --ws-max-size.
WEBSOCKET_MAX_FRAME_BYTES=65536
WEBSOCKET_MAX_CONNECTIONS_PER_IP=10
WEBSOCKET_MAX_CONNECTIONS_PER_USER=3
PROTECTED_MEDIA_URL_TTL_SECONDS=300

# Operational event-loop lag sampling.
EVENT_LOOP_LAG_INTERVAL_SECONDS=1
EVENT_LOOP_LAG_WARN_MS=500

# Prometheus endpoint and structured request logging. Keep the metrics endpoint
# on a monitoring network; when a bearer token is configured, both CIDR and
# token checks must pass. Successful requests are metrics-only by default;
# 4xx/5xx request events are written as redacted JSON lines.
METRICS_ENABLED=true
METRICS_ALLOWED_CIDRS=127.0.0.1/32,::1/128
# METRICS_BEARER_TOKEN=replace-with-a-secret-manager-value
STRUCTURED_REQUEST_LOG_MODE=errors
# Leave false in production so arbitrary exception/message text cannot carry
# business PII into runtime logs. Debug environments may opt in temporarily.
LOG_INCLUDE_EXCEPTION_DETAILS=false
# Point this to the signed state file produced by an independently verified restore drill.
BIDDING_RESTORE_DRILL_STATE_FILE=/var/lib/biddingflow/observability/last-restore-drill.json

# First-run admin account.
# ADMIN_PASSWORD is required; the server fails fast if it is empty.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
ADMIN_EMAIL=REPLACE_WITH_PRODUCTION_ADMIN_EMAIL
DEFAULT_ORG_NAME=HTD

# Health checks for the process supervisor / reverse proxy:
#   GET /health/live   -> process is running
#   GET /health/ready  -> schema, admin bootstrap and database are ready

# Argon2id cost for new/changed passwords. Benchmark on production-class
# hardware before changing; hashing runs in a bounded CPU lane.
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST_KIB=65536
ARGON2_PARALLELISM=2

# HTTP API origins, comma-separated. Production must use HTTPS origins only.
# Same-origin production: use exactly APP_PUBLIC_URL.
CORS_ORIGINS=https://REPLACE_WITH_PRODUCTION_DOMAIN

# WebSocket browser origins, comma-separated. Usually the same value as CORS_ORIGINS.
# Use https:// origins here; the app converts them to wss:// for CSP connect-src.
ALLOWED_WS_ORIGINS=https://REPLACE_WITH_PRODUCTION_DOMAIN

# Defense-in-depth IP/CIDR allowlist for super-admin actions. Authentication and
# recent password re-authentication are still mandatory. Never use "*" in production.
SUPER_ADMIN_IP_ALLOWLIST=

# Comma-separated proxy IP/CIDR ranges allowed to supply X-Forwarded-For.
# The bundled Nginx example proxies locally and overwrites attacker headers.
# Leave empty only when the application is reached directly without a proxy.
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# Seconds that a successful password step-up authorizes sensitive super-admin mutations.
PRIVILEGED_REAUTH_TTL_SECONDS=600

# Shared persistent limiter defaults. Endpoint, IP and identity are separate buckets.
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_WINDOW_SECONDS=60

# Authenticated partner lookup protection. The API applies fixed limits of
# 12 requests/IP/minute and 8 requests/user/minute; these values bound outbound
# work, provider latency, retry and shared PostgreSQL cache behavior.
PARTNER_LOOKUP_MAX_CONCURRENCY=4
PARTNER_LOOKUP_SLOT_TIMEOUT_SECONDS=0.25
PARTNER_LOOKUP_LOCK_TIMEOUT_SECONDS=1
PARTNER_LOOKUP_POLL_SECONDS=1
PARTNER_LOOKUP_MAX_POLL_SECONDS=10
PARTNER_LOOKUP_POSITIVE_CACHE_SECONDS=21600
PARTNER_LOOKUP_NEGATIVE_CACHE_SECONDS=300
PARTNER_UPSTREAM_MAX_ATTEMPTS=2
PARTNER_MUASAMCONG_TIMEOUT_SECONDS=6
PARTNER_MUASAMCONG_AREA_TIMEOUT_SECONDS=2
PARTNER_VIETQR_TIMEOUT_SECONDS=4
PARTNER_ESCODATA_TIMEOUT_SECONDS=4

# Unified Mua Sắm Công lookup/import worker. Token and cookie stay in memory
# inside the server-owned JSONL worker and are never returned to the browser.
PROCUREMENT_LOOKUP_ENABLED=false
PROCUREMENT_BROWSER_MODE=standard
# Optional isolated compatibility profile. It does not solve CAPTCHA, replay
# tokens/cookies, forge challenges or weaken Chromium security boundaries.
RESEARCH_STEALTH_ENABLED=false
RESEARCH_STEALTH_ALLOWED_TARGET_HOSTS=muasamcong.mpi.gov.vn
MUASAMCONG_DRIVER_VUE2=true
MUASAMCONG_DRIVER_GENERIC=true
MUASAMCONG_EXTRACT_NETWORK=true
MUASAMCONG_EXTRACT_VUE=true
MUASAMCONG_EXTRACT_VUE3=true
MUASAMCONG_EXTRACT_REACT=true
MUASAMCONG_EXTRACT_DOM=true
PROCUREMENT_BROWSER_IDLE_TTL_SECONDS=900
PROCUREMENT_BROWSER_WORKER_TIMEOUT_SECONDS=25
PROCUREMENT_BROWSER_QUEUE_TIMEOUT_MS=250
PROCUREMENT_LOOKUP_TIMEOUT_SECONDS=30
PROCUREMENT_LOOKUP_COALESCE_TIMEOUT_SECONDS=25
PROCUREMENT_LOOKUP_CACHE_TTL_SECONDS=300
PROCUREMENT_LOOKUP_SHARED_CACHE_ENABLED=true
PROCUREMENT_LOOKUP_PLAN_CACHE_TTL_SECONDS=900
PROCUREMENT_LOOKUP_OPEN_PACKAGE_CACHE_TTL_SECONDS=300
PROCUREMENT_LOOKUP_CLOSED_PACKAGE_CACHE_TTL_SECONDS=3600
PROCUREMENT_RAW_CACHE_TTL_SECONDS=900
MUASAMCONG_BROWSER_EXECUTABLE_PATH=
# Public reCAPTCHA site key currently published by muasamcong.mpi.gov.vn.
# This is a browser identifier, not the private reCAPTCHA secret key.
MUASAMCONG_RECAPTCHA_SITE_KEY="6LeQH9gpAAAAAPpzhkvYzd8QCrP-QyLVRSw_SD9U"
MUASAMCONG_BROWSER_HEADLESS=true
MUASAMCONG_ENDPOINT_PROFILE=2026.08
MUASAMCONG_SESSION_TTL_SECONDS=1800
MUASAMCONG_SESSION_TIMEOUT_SECONDS=55
MUASAMCONG_API_TIMEOUT_SECONDS=15
MUASAMCONG_API_RETRIES=1
MUASAMCONG_CIRCUIT_SECONDS=30
MUASAMCONG_MAX_CONCURRENCY=6
MUASAMCONG_API_QUEUE_TIMEOUT_MS=5000
MUASAMCONG_WORKER_TIMEOUT_SECONDS=60
MUASAMCONG_WORKER_QUEUE_TIMEOUT_MS=1000
MUASAMCONG_REQUEST_TIMEOUT_SECONDS=60
MUASAMCONG_MAX_RESPONSE_BYTES=4194304
MUASAMCONG_NAVIGATION_TIMEOUT_MS=20000
MUASAMCONG_ACTION_TIMEOUT_MS=15000
MUASAMCONG_DIAGNOSTICS_ENABLED=false
MUASAMCONG_DIAGNOSTICS_DIR=data/procurement-diagnostics
MUASAMCONG_SHADOW_PARSER_ENABLED=false

# Login session expiry when "remember me" is not selected, in hours.
SESSION_EXPIRY_HOURS=4

# Login session expiry when "remember me" is selected, in hours.
SESSION_REMEMBER_EXPIRY_HOURS=24

# Browser inactivity timeout before automatic logout, in hours.
SESSION_INACTIVITY_TIMEOUT_HOURS=10

# Minimum seconds between persistent last-seen updates for an active session.
SESSION_ACTIVITY_TOUCH_SECONDS=300
SESSION_RETENTION_DAYS=30

# Google OAuth 2.0
# Google Cloud Console > OAuth Client > Authorized JavaScript origins
# must include the exact app origin, without a path.
# Google Identity Services requires both unqualified localhost and the ported
# localhost origin for local development. Register all applicable entries:
#   http://localhost
#   http://localhost:8000
#   http://127.0.0.1:8000
# Do not add a path or trailing slash. Production must use its exact HTTPS origin.
# "auto" enables Google Identity in production and keeps it off in development.
# Set this to "true" locally only after registering the exact local origins above.
GOOGLE_AUTH_ENABLED=auto
GOOGLE_CLIENT_ID=

# Read-only BiddingFlow AI assistant. Disabled by default. Keep API keys only
# in the backend secret store; never expose them to the browser. Supported
# protocols and per-provider examples: docs/ai/AI_PROVIDER_ADAPTERS.md.
AI_ENABLED=false
AI_PROVIDER=openai
# Vendor-neutral settings take precedence. Leave blank to use the provider's
# documented default endpoint or the backwards-compatible values below.
AI_API_KEY=
AI_BASE_URL=
# Custom hosted endpoints must be HTTPS and exact-matched here. Official
# OpenAI/Anthropic/Gemini hosts and canonical Azure resource hosts are built in.
AI_PROVIDER_ALLOWED_HOSTS=
# Ambient HTTP(S)_PROXY variables are ignored. To use a reviewed proxy, set
# both its HTTPS URL and its exact host allowlist explicitly.
AI_PROVIDER_PROXY_URL=
AI_PROVIDER_ALLOWED_PROXY_HOSTS=
AI_API_VERSION=
AI_PROVIDER_VERSION=
AI_AUTH_TYPE=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
AI_MODEL=gpt-5.6
AI_MAX_OUTPUT_TOKENS=1200
AI_REQUEST_TIMEOUT_SECONDS=45
AI_TOOL_TIMEOUT_SECONDS=15
AI_DAILY_REQUEST_LIMIT=100
AI_DAILY_TOKEN_LIMIT=100000
AI_CONVERSATION_RETENTION_DAYS=30
AI_PROVIDER_STORE_RESPONSES=false
# OpenAI-compatible Chat gateways can opt out of usage stream_options when an
# older implementation rejects it. Disabling usage weakens token accounting.
AI_CHAT_INCLUDE_USAGE=true
AI_CHAT_MAX_TOKENS_FIELD=max_tokens
AI_KNOWLEDGE_ENABLED=true
AI_KNOWLEDGE_TOP_K=5
AI_KNOWLEDGE_MIN_SCORE=0.12
AI_KNOWLEDGE_MAX_CONTEXT_CHARS=16000
AI_KNOWLEDGE_CANDIDATE_LIMIT=2000
# Procurement advice uses an isolated public-web search adapter. The adapter
# sends only a sanitized legal question and accepts HTTPS sources from this
# allowlist; it never sends workspace records or RAG text to the search API.
AI_WEB_SEARCH_ENABLED=false
AI_WEB_SEARCH_PROVIDER=gemini_grounding
AI_WEB_SEARCH_API_KEY=
AI_WEB_SEARCH_BASE_URL=
AI_WEB_SEARCH_PROVIDER_ALLOWED_HOSTS=
AI_WEB_SEARCH_PROXY_URL=
AI_WEB_SEARCH_ALLOWED_PROXY_HOSTS=
AI_WEB_SEARCH_MODEL=
AI_WEB_SEARCH_TIMEOUT_SECONDS=20
AI_WEB_SEARCH_ALLOWED_DOMAINS=vanban.chinhphu.vn,vbpl.vn,muasamcong.gov.vn,muasamcong.mpi.gov.vn

# Contractor violation lookup uses only the public service calls made by the
# official MuaSamCong frontend. Keep the official HTTPS host; the adapter exact-
# matches identifiers and never crawls additional result pages.
VNEPS_VIOLATION_SERVICE_BASE=https://muasamcong.mpi.gov.vn/o/egp-portal-org-ind-violating/services
VNEPS_VIOLATION_TIMEOUT_SECONDS=6
VNEPS_VIOLATION_RETRIES=1
VNEPS_VIOLATION_CIRCUIT_SECONDS=30
VNEPS_VIOLATION_MAX_CONCURRENCY=4
VNEPS_VIOLATION_SLOT_TIMEOUT_SECONDS=0.25
VNEPS_VIOLATION_CACHE_SECONDS=21600
# CI/E2E may set this to tests/fixtures/vneps_contractor_violations.json.
# It is rejected when APP_ENV=production.
VNEPS_VIOLATION_FIXTURE_PATH=

# Nhập KHLCNT/TBMT/mở thầu. Dùng provider muasamcong cho production; fixture
# chỉ dùng development/test và vẫn bị cấm trong production.
PROCUREMENT_IMPORT_ENABLED=false
PROCUREMENT_PROVIDER=muasamcong
PROCUREMENT_IMPORT_PREVIEW_TTL_SECONDS=300
# Legacy aliases remain accepted during rollout:
VNEPS_PROCUREMENT_IMPORT_ENABLED=false
VNEPS_PROCUREMENT_PROVIDER=disabled
VNEPS_PROCUREMENT_FIXTURE_PATH=
VNEPS_PROCUREMENT_API_AUTHORIZATION_CONFIRMED=false
VNEPS_PROCUREMENT_TIMEOUT_SECONDS=8
VNEPS_PROCUREMENT_MAX_RESPONSE_BYTES=1048576
VNEPS_PROCUREMENT_CACHE_TTL_SECONDS=900
VNEPS_PROCUREMENT_PREVIEW_TTL_SECONDS=300
VNEPS_PROCUREMENT_MAX_CONCURRENCY=8
VNEPS_PROCUREMENT_SLOT_TIMEOUT_SECONDS=0.25
VNEPS_PROCUREMENT_RETRIES=1
VNEPS_PROCUREMENT_CIRCUIT_SECONDS=30
# Optional provider-specific aliases:
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# ANTHROPIC_VERSION=2023-06-01
# GEMINI_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://REPLACE.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_API_VERSION=v1

# Runtime logs default to BIDDING_DATA_DIR/logs and rotate automatically.
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5
