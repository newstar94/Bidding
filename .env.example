# SMTP configuration for sending email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_SENDER=your-email@gmail.com

# Application server
# For production behind a reverse proxy, bind the app to an internal address.
# Public browser origins are configured below in CORS_ORIGINS and ALLOWED_WS_ORIGINS.
APP_HOST=127.0.0.1
APP_PORT=8000
APP_ENV=production
APP_DEBUG=False
APP_SECURE_COOKIES=True
# Canonical browser origin used for one-time email links. No trailing path.
APP_PUBLIC_URL=https://yourdomain.com

# Secure frontend build. Production enables obfuscation and controlled dead-code
# injection by default. Set false only for an internal diagnostic build.
ENABLE_JS_DEAD_CODE_INJECTION=true
# Debug protection can interfere with browser diagnostics and remains opt-in.
ENABLE_JS_DEBUG_PROTECTION=false

# SQLite production layout. Use absolute paths on local persistent volumes;
# never place the DB or its WAL files in OneDrive/Dropbox/Google Drive/iCloud.
# Development should also use a runtime directory outside the source tree;
# production rejects a relative or source-tree database path.
BIDDING_DB_PATH=/var/lib/biddingflow/database/bidding.db
BIDDING_SQLITE_SINGLE_WRITER=true
# Set true only after the DB, upload/template and backup paths below are on
# encrypted volumes (for example LUKS/dm-crypt, BitLocker or encrypted block storage).
DATA_AT_REST_ENCRYPTION_CONFIRMED=true
# ISO date of the last SMTP/OAuth/application-secret rotation. Production
# refuses to start when this attestation is missing or older than 90 days.
SECRET_ROTATION_CONFIRMED_AT=2026-07-15

# Backups must be outside the database directory and should be replicated to
# encrypted off-host/object storage by infrastructure after each successful run.
BIDDING_BACKUP_DIR=/var/backups/biddingflow
BIDDING_BACKUP_RETENTION_COUNT=14

# Mutable uploads, user Word templates, worker temp and logs are deliberately
# separate from the DB directory so they can use independent mounts/retention.
SYNC_TOMBSTONE_RETENTION_DAYS=90
SYNC_MUTATION_RETENTION_DAYS=30
API_IDEMPOTENCY_RETENTION_DAYS=7
AUDIT_RETENTION_DAYS=3650
AUDIT_CHAIN_VERIFY_INTERVAL_SECONDS=300
AUDIT_CHECKPOINT_INTERVAL_SECONDS=86400
# Point this at a separately protected volume replicated to immutable/off-host storage.
AUDIT_CHECKPOINT_DIR=
# Store this value in the production secret manager, never in source control.
AUDIT_CHECKPOINT_HMAC_KEY=
# Set true only after immutable/off-host replication is actually enabled.
AUDIT_CHECKPOINT_OFFHOST_CONFIRMED=false
BIDDING_RESTORE_DRILL_HMAC_KEY=
OPERATIONAL_ARTIFACT_VERIFY_INTERVAL_SECONDS=900
BIDDING_UPLOAD_DIR=/var/lib/biddingflow/uploads
BIDDING_WORD_TEMPLATE_DIR=/var/lib/biddingflow/word-templates
DOCUMENT_WORKER_TEMP_DIR=/var/tmp/biddingflow-document-worker

# Isolated DOCX/XLSX worker limits. Every import/export runs in a disposable
# subprocess outside the ASGI event loop.
DOCUMENT_WORKER_MAX_CONCURRENCY=2
DOCUMENT_WORKER_QUEUE_TIMEOUT_SECONDS=2
DOCUMENT_WORKER_QUEUE_SIZE=2
DOCUMENT_WORKER_TIMEOUT_SECONDS=45
DOCUMENT_WORKER_CPU_SECONDS=40
DOCUMENT_WORKER_MAX_MEMORY_MB=768
DOCUMENT_WORKER_MAX_OUTPUT_MB=64
# Linux only: when the web service starts as root, set both to a dedicated
# unprivileged account and enable the privilege-drop requirement.
# DOCUMENT_WORKER_UID=65534
# DOCUMENT_WORKER_GID=65534
DOCUMENT_WORKER_REQUIRE_PRIVILEGE_DROP=false

# Bounded pool for legacy/blocking network and small filesystem operations.
BLOCKING_IO_MAX_WORKERS=8
BLOCKING_IO_MAX_QUEUE=16

# SQLite work is isolated from the event loop. Writes stay serialized.
DATABASE_READ_WORKERS=4
DATABASE_READ_QUEUE=16
DATABASE_WRITE_QUEUE=32

# PBKDF2 and other CPU-heavy request work use a separate bounded pool.
CPU_WORKER_COUNT=2
CPU_WORKER_QUEUE=8

# Email-change step-up and OTP throttling.
EMAIL_CHANGE_OTP_TTL_SECONDS=600
EMAIL_CHANGE_REQUEST_MAX=3
EMAIL_CHANGE_REQUEST_WINDOW_SECONDS=900
EMAIL_CHANGE_VERIFY_MAX=5
EMAIL_CHANGE_VERIFY_WINDOW_SECONDS=600

# Actual ASGI stream limits (the reverse proxy must be at least as strict).
REQUEST_MAX_JSON_BYTES=1048576
REQUEST_MAX_SYNC_BYTES=10485760
# Includes multipart overhead; each DOCX/XLSX file remains limited to 10MB.
REQUEST_MAX_DOCUMENT_BYTES=11534336
SYNC_MAX_BATCH_ITEMS=2000
EXCEL_MAX_IMPORT_ROWS=10000

# WebSocket quotas. Keep WEBSOCKET_MAX_FRAME_BYTES equal to Uvicorn --ws-max-size.
WEBSOCKET_MAX_FRAME_BYTES=65536
WEBSOCKET_MAX_CONNECTIONS_PER_IP=10
WEBSOCKET_MAX_CONNECTIONS_PER_USER=3
PROTECTED_MEDIA_URL_TTL_SECONDS=300

# Operational event-loop lag sampling.
EVENT_LOOP_LAG_INTERVAL_SECONDS=1
EVENT_LOOP_LAG_WARN_MS=500

# Prometheus endpoint and structured request logging. Keep the metrics endpoint
# on a monitoring network; when a bearer token is configured, both CIDR and
# token checks must pass. Successful requests are metrics-only by default;
# 4xx/5xx request events are written as redacted JSON lines.
METRICS_ENABLED=true
METRICS_ALLOWED_CIDRS=127.0.0.1/32,::1/128
# METRICS_BEARER_TOKEN=replace-with-a-secret-manager-value
STRUCTURED_REQUEST_LOG_MODE=errors
# Leave false in production so arbitrary exception/message text cannot carry
# business PII into runtime logs. Debug environments may opt in temporarily.
LOG_INCLUDE_EXCEPTION_DETAILS=false
# Updated only by scripts/record_restore_drill.py after both trees verify.
BIDDING_RESTORE_DRILL_STATE_FILE=/var/backups/biddingflow/last-restore-drill.json

# First-run admin account.
# ADMIN_PASSWORD is required; the server fails fast if it is empty.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_strong_password_here
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@yourdomain.com
DEFAULT_ORG_NAME=HTD

# Health checks for the process supervisor / reverse proxy:
#   GET /health/live   -> process is running
#   GET /health/ready  -> schema, admin bootstrap and database are ready

# PBKDF2-SHA256 rounds for new/changed passwords.
PASSWORD_HASH_ITERATIONS=310000

# HTTP API origins, comma-separated. Production must use HTTPS origins only.
# Example with www: CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CORS_ORIGINS=https://yourdomain.com

# WebSocket browser origins, comma-separated. Usually the same value as CORS_ORIGINS.
# Use https:// origins here; the app converts them to wss:// for CSP connect-src.
ALLOWED_WS_ORIGINS=https://yourdomain.com

# Defense-in-depth IP/CIDR allowlist for super-admin actions. Authentication and
# recent password re-authentication are still mandatory. Never use "*" in production.
SUPER_ADMIN_IP_ALLOWLIST=203.0.113.10/32

# Comma-separated proxy IP/CIDR ranges allowed to supply X-Forwarded-For.
# The bundled Nginx example proxies locally and overwrites attacker headers.
# Leave empty only when the application is reached directly without a proxy.
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# Seconds that a successful password step-up authorizes sensitive super-admin mutations.
PRIVILEGED_REAUTH_TTL_SECONDS=600

# Shared persistent limiter defaults. Endpoint, IP and identity are separate buckets.
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_WINDOW_SECONDS=60

# Login session expiry when "remember me" is not selected, in hours.
SESSION_EXPIRY_HOURS=4

# Login session expiry when "remember me" is selected, in hours.
SESSION_REMEMBER_EXPIRY_HOURS=24

# Browser inactivity timeout before automatic logout, in hours.
SESSION_INACTIVITY_TIMEOUT_HOURS=10

# Minimum seconds between persistent last-seen updates for an active session.
SESSION_ACTIVITY_TOUCH_SECONDS=60

# Google OAuth 2.0
# Google Cloud Console > OAuth Client > Authorized JavaScript origins
# must include the exact app origin, without a path.
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Runtime logs are stored outside source artifacts and rotated automatically.
# Use an absolute path on the persistent runtime volume in production.
BIDDING_LOG_DIR=/var/log/biddingflow
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5
