# Cấu hình SMTP để gửi email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_SENDER=your-email@gmail.com

# Cấu hình máy chủ ứng dụng
APP_HOST=127.0.0.1
APP_PORT=8000
APP_DEBUG=False

# Bảo mật: Bật cookie Secure khi chạy sau HTTPS reverse proxy (nginx/caddy)
APP_SECURE_COOKIES=False

# Tài khoản admin mặc định (chỉ dùng khi DB chưa có user nào)
ADMIN_PASSWORD=your_strong_password_here
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@localhost

# CORS: Danh sách domain được phép (phân cách bằng dấu phẩy)
# CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# Bảo mật: Danh sách IP được phép truy cập quyền super_admin
# SUPER_ADMIN_IP_ALLOWLIST=127.0.0.1,::1
