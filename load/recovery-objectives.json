{
  "contractVersion": 1,
  "scope": "postgresql-production",
  "application": {
    "rpoSeconds": 900,
    "rtoSeconds": 7200,
    "owner": "platform-oncall"
  },
  "components": {
    "postgresql": {
      "rpoSeconds": 300,
      "rtoSeconds": 3600,
      "mechanism": "encrypted base backup plus continuous WAL archiving/PITR",
      "owner": "database-oncall"
    },
    "businessFiles": {
      "rpoSeconds": 900,
      "rtoSeconds": 7200,
      "mechanism": "versioned object storage replication plus immutable backup manifest",
      "owner": "platform-oncall"
    },
    "auditCheckpoints": {
      "rpoSeconds": 300,
      "rtoSeconds": 3600,
      "mechanism": "off-host WORM replication with retention lock",
      "owner": "security-oncall"
    }
  },
  "retention": {
    "pitrDays": 35,
    "immutableBackupDays": 90,
    "monthlyRestoreDrillIntervalDays": 30,
    "restoreDrillAlertAfterDays": 35,
    "verifiedBackupAlertAfterHours": 26
  }
}
