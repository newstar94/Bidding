# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Cấu hình môi trường chứa thông tin nhạy cảm
.env

# Database SQLite (Bỏ qua file DB thay đổi cục bộ)
data/bidding.db
data/bidding.db-*
data/*.writer.lock
backend/db/bidding.db*

# Log files
*.log
data/logs/

# Runtime images and user-specific Word templates
data/templates/images/
data/templates/words/config.json
data/templates/words/*/

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Local editor metadata
.vscode/

# Scratch files
scratch/

