# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Bắt buộc giữ lại các module Python được biên dịch sẵn vì không có file nguồn .py tương ứng
!models/*.cpython-314.pyc
!controllers/*.cpython-314.pyc

# Cấu hình môi trường chứa thông tin nhạy cảm
.env

# Database SQLite (Bỏ qua file DB thay đổi cục bộ)
models/bidding.db

# Log files
*.log

# Uploaded assets
uploads/

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Local editor metadata
.vscode/

# Scratch files
scratch/

# Tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
coverage.xml
htmlcov/
.nyc_output/
coverage/
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Local test suite and runner configuration (not shipped to production)
tests/
playwright.config.js
pytest.ini

# Test output is ignored above; test sources and runner configuration are tracked.

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Vite cache & build
.vite/
dist/
.pw-bidding-profile/

# Temporary and local-only files
*.tmp
*.temp
*.bak
*.swp
*.swo
*.pid
*.pid.lock
*.local
.idea/
