{
  "name": "biddingflow-frontend",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:schema-runtime": "python scripts/generate_schema_runtime.py",
    "check:schema-runtime": "python scripts/generate_schema_runtime.py --check",
    "generate:bootstrap-assets": "python scripts/generate_bootstrap_asset_urls.py",
    "check:bootstrap-assets": "python scripts/generate_bootstrap_asset_urls.py --check && node scripts/generate_landing_icons.mjs --check",
    "check:route-css": "node scripts/check_route_css_split.mjs",
    "lint:security": "eslint frontend && node scripts/check_trusted_types_policy.mjs",
    "audit:npm": "npm audit && npm audit --omit=dev",
    "audit:dependencies": "npm run audit:npm && pip-audit -r requirements.txt",
    "sbom": "python scripts/generate_sbom.py",
    "audit:vendor": "python scripts/audit_vendor_assets.py && node scripts/check_sheetjs_vendor.cjs && node scripts/check_excel_archive_guard.mjs",
    "check:legal": "python scripts/check_legal_readiness.py",
    "check:legal:production": "python scripts/check_legal_readiness.py --production-public",
    "build": "npm run build:secure",
    "build:secure": "npm run check:bootstrap-assets && npm run lint:security && npm run audit:vendor && vite build --mode secure && node scripts/check_secure_build_artifacts.mjs && npm run check:route-css",
    "package:production": "npm run check:legal:production && npm run build:secure && python scripts/package_production.py",
    "package:production:from-build": "npm run check:legal:production && python scripts/package_production.py",
    "symbolicate:client": "node scripts/symbolicate_client_error.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "eslint": "10.7.0",
    "javascript-obfuscator": "5.4.3",
    "source-map-js": "1.2.2",
    "vite": "8.1.4"
  },
  "dependencies": {
    "@tabler/core": "1.4.0",
    "dompurify": "3.4.16",
    "playwright": "1.62.0",
    "puppeteer": "^25.6.0"
  },
  "overrides": {
    "brace-expansion": "5.0.12",
    "fast-uri": "3.1.5"
  }
}
