{
  "name": "biddingflow-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "npm run lint && npm run audit:modules && npm run audit:size && npm run audit:dead && npm run audit:a11y && npm run audit:styles && npm run audit:vendor && python -m compileall -q backend scripts && npm run build && npm run audit:package && npm run audit:bundle && npm run test:unit && npm run test:api",
    "audit:modules": "node scripts/audit_module_references.mjs",
    "audit:size": "node scripts/audit_source_size.mjs",
    "audit:dead": "node scripts/audit_dead_code.mjs",
    "audit:a11y": "node scripts/audit_accessibility.mjs",
    "audit:styles": "node scripts/audit_inline_styles.mjs",
    "audit:bundle": "node scripts/audit_bundle_budget.mjs",
    "audit:package": "python scripts/package_production.py --check",
    "audit:npm": "npm audit --audit-level=high",
    "audit:python": "python -m pip_audit --no-deps -r requirements/runtime.lock.txt",
    "audit:vendor": "node scripts/audit_vendor_assets.mjs && retire --path views/vendor",
    "audit:secrets": "python scripts/audit_secrets.py",
    "audit:dependencies": "npm run audit:npm && npm run audit:python && npm run audit:vendor && npm run audit:secrets",
    "sbom": "npm run sbom:npm && npm run sbom:vendor && npm run sbom:python",
    "sbom:npm": "cyclonedx-npm --package-lock-only --output-reproducible --spec-version 1.6 --output-format JSON --output-file sbom/npm.cdx.json --validate",
    "sbom:vendor": "node scripts/generate_vendor_sbom.mjs",
    "sbom:python": "python -m cyclonedx_py requirements requirements/runtime.lock.txt --pyproject pyproject.toml --output-reproducible --spec-version 1.6 --output-format JSON --output-file sbom/python-runtime.cdx.json --validate",
    "lint": "npm run lint:js && npm run lint:py",
    "lint:js": "node scripts/lint_js.mjs",
    "lint:py": "python scripts/lint_python.py",
    "generate:schema": "python scripts/generate_schema_contract.py",
    "build": "vite build --mode secure",
    "build:plain": "vite build --mode production",
    "build:secure": "vite build --mode secure",
    "package:production": "npm run build:secure && python scripts/package_production.py",
    "test": "npm run test:api && npm run test:e2e",
    "test:api": "python -m pytest tests/api",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:install-browsers": "playwright install"
    ,"benchmark:database": "python scripts/benchmark_database.py --output docs/BENCHMARK_RESULTS.json"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "6.0.0",
    "@playwright/test": "1.61.1",
    "esbuild": "0.28.1",
    "javascript-obfuscator": "5.4.3",
    "retire": "5.4.3",
    "vite": "8.1.4"
  }
}
