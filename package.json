{
  "name": "biddingflow-frontend",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "python -m pytest -q --cov=backend --cov-branch --cov-report=term --cov-report=json:coverage.json --cov-fail-under=28 && python scripts/check_critical_coverage.py coverage.json && npm run test:js",
    "test:js": "node --test --test-concurrency=1 --test-timeout=60000 tests/js/*.test.mjs",
    "lint:security": "eslint frontend && node scripts/check_trusted_types_policy.mjs",
    "lint:python": "python scripts/check_python_quality.py",
    "lint:encoding": "python scripts/check_mojibake.py",
    "lint:modules": "node scripts/check_frontend_modules.mjs",
    "lint:debt": "python scripts/check_frontend_debt.py",
    "audit:dependencies": "npm audit --omit=dev && pip-audit -r requirements.txt",
    "sbom": "python scripts/generate_sbom.py",
    "audit:vendor": "python scripts/audit_vendor_assets.py && node scripts/check_sheetjs_vendor.cjs && node scripts/check_excel_archive_guard.mjs",
    "check:legal": "python scripts/check_legal_readiness.py",
    "check:legal:production": "python scripts/check_legal_readiness.py --production-public",
    "build": "npm run build:secure",
    "build:secure": "npm run lint:security && npm run audit:vendor && vite build --mode secure && node scripts/check_secure_build_artifacts.mjs",
    "package:production": "npm run check:legal:production && npm run build:secure && python scripts/package_production.py",
    "check:quality": "python -m compileall -q backend scripts tests && npm run lint:python && npm run lint:encoding && npm run lint:security && npm run lint:modules && npm run lint:debt && npm test",
    "check": "npm run check:quality && npm run build:secure && python scripts/audit_fk_indexes.py && python scripts/package_production.py --check && npm run sbom",
    "test:auth-shell": "node --env-file-if-exists=.env scripts/verify_auth_shell.mjs",
    "test:auth-roles-e2e": "node --env-file-if-exists=.env scripts/verify_auth_roles_e2e.mjs",
    "test:bidder-goods-e2e": "node --env-file-if-exists=.env scripts/run_bidder_goods_e2e.cjs",
    "test:crud-modules-e2e": "node --env-file-if-exists=.env scripts/verify_crud_modules_e2e.mjs",
    "test:multi-assignee-e2e": "node --env-file-if-exists=.env scripts/verify_multi_assignee_activity_e2e.mjs",
    "test:joint-venture-e2e": "node --env-file-if-exists=.env scripts/verify_joint_venture_e2e.mjs",
    "test:low-price-conflict-e2e": "node --env-file-if-exists=.env scripts/verify_low_price_conflict_e2e.mjs",
    "test:offline-sync-e2e": "node --env-file-if-exists=.env scripts/verify_offline_sync_e2e.mjs",
    "test:package-pairwise-e2e": "node --env-file-if-exists=.env scripts/verify_package_pairwise_e2e.mjs",
    "test:lifecycle": "node --env-file-if-exists=.env scripts/verify_full_lifecycle.mjs",
    "test:performance": "node --env-file-if-exists=.env scripts/measure_startup.mjs --assert",
    "benchmark:entity-indexes": "node scripts/benchmark_entity_indexes.mjs",
    "benchmark:excel": "node scripts/benchmark_excel_parsing.mjs",
    "benchmark:tables": "node scripts/profile_table_virtualization.mjs",
    "benchmark:obfuscation": "node scripts/benchmark_obfuscation.mjs",
    "test:ui-quality-e2e": "node --env-file-if-exists=.env scripts/verify_ui_quality_e2e.mjs",
    "test:authenticated-ui-matrix": "node --env-file-if-exists=.env scripts/verify_authenticated_ui_matrix.mjs",
    "test:turnstile-local": "node scripts/verify_turnstile_local_e2e.mjs",
    "test:turnstile-local-matrix": "node scripts/verify_turnstile_local_matrix.mjs",
    "test:e2e:smoke": "node --env-file-if-exists=.env node_modules/@playwright/test/cli.js test --config=playwright.config.mjs",
    "test:e2e:smoke:headed": "node --env-file-if-exists=.env node_modules/@playwright/test/cli.js test --config=playwright.config.mjs --headed",
    "test:e2e:business-matrix": "node e2e/generators/generate_business_matrix.mjs",
    "test:security-deploy": "python -m pytest -q tests/test_turnstile.py tests/test_http_resource_limits.py tests/test_deploy_security_templates.py tests/test_security_deployment_preflight.py tests/test_overload_recovery.py && npm run test:turnstile-local-matrix"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "1.62.0",
    "esbuild": "0.28.1",
    "eslint": "10.7.0",
    "javascript-obfuscator": "5.4.3",
    "vite": "8.1.4"
  },
  "dependencies": {
    "dompurify": "3.4.13"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "fast-uri": "3.1.5"
  }
}
