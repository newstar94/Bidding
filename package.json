{
  "name": "biddingflow-frontend",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint:security": "eslint frontend && node scripts/check_trusted_types_policy.mjs",
    "audit:vendor": "python scripts/audit_vendor_assets.py && node scripts/check_sheetjs_vendor.cjs && node scripts/check_excel_archive_guard.mjs",
    "build": "npm run lint:security && npm run audit:vendor && vite build --mode secure",
    "build:secure": "npm run lint:security && npm run audit:vendor && vite build --mode secure",
    "package:production": "npm run build:secure && python scripts/package_production.py",
    "test:auth-shell": "node --env-file-if-exists=.env scripts/verify_auth_shell.mjs",
    "test:lifecycle": "node --env-file-if-exists=.env scripts/verify_full_lifecycle.mjs",
    "test:performance": "node --env-file-if-exists=.env scripts/measure_startup.mjs --assert"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "esbuild": "0.28.1",
    "eslint": "10.7.0",
    "javascript-obfuscator": "5.5.0",
    "vite": "8.1.4"
  },
  "dependencies": {
    "dompurify": "3.4.12"
  },
  "overrides": {
    "brace-expansion": "5.0.8"
  }
}
