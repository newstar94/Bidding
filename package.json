{
  "name": "biddingflow-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "npm run lint && npm run audit:modules && npm run audit:dead && python -m compileall -q backend scripts && npm run build -- --emptyOutDir false && npm run test:unit && npm run test:api",
    "audit:modules": "node scripts/audit_module_references.mjs",
    "audit:dead": "node scripts/audit_dead_code.mjs",
    "lint": "npm run lint:js && npm run lint:py",
    "lint:js": "node scripts/lint_js.mjs",
    "lint:py": "python scripts/lint_python.py",
    "generate:schema": "python scripts/generate_schema_contract.py",
    "build": "vite build",
    "build:secure": "vite build --mode secure",
    "test": "npm run test:api && npm run test:e2e",
    "test:api": "python -m pytest tests/api",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:install-browsers": "playwright install"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "esbuild": "^0.28.1",
    "javascript-obfuscator": "^5.4.3",
    "vite": "^8.1.4"
  }
}
